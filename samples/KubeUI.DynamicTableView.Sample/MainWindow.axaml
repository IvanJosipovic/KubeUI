<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:KubeUI.DynamicTableView.Sample"
        xmlns:sys="using:System"
        xmlns:table="using:KubeUI.DynamicTableView"
        x:Class="KubeUI.DynamicTableView.Sample.MainWindow"
        Title="KubeUI.DynamicTableView sample"
        Width="960"
        Height="600">
  <Window.Resources>
    <local:SampleColumnDefinitions x:Key="XamlColumnDefinitions">
      <local:SampleColumnDefinition Key="name"
                                    Header="Name"
                                    ValueType="{x:Type x:String}"
                                    ValueSelector="{x:Static local:SampleColumnSelectors.Name}"
                                    WidthMode="Star" />
      <local:SampleColumnDefinition Key="restarts"
                                    Header="Restarts"
                                    ValueType="{x:Type x:Int32}"
                                    ValueSelector="{x:Static local:SampleColumnSelectors.Restarts}" />
      <local:SampleColumnDefinition Key="ready"
                                    Header="Ready"
                                    ValueType="{x:Type x:Boolean}"
                                    ValueSelector="{x:Static local:SampleColumnSelectors.Ready}" />
      <local:SampleColumnDefinition Key="cpuCores"
                                    Header="CPU cores"
                                    ValueType="{x:Type x:Decimal}"
                                    ValueSelector="{x:Static local:SampleColumnSelectors.CpuCores}" />
      <local:SampleColumnDefinition Key="memory"
                                    Header="Memory"
                                    ValueType="{x:Type x:Single}"
                                    ValueSelector="{x:Static local:SampleColumnSelectors.Memory}" />
      <local:SampleColumnDefinition Key="createdAt"
                                    Header="Created"
                                    ValueType="{x:Type sys:DateTimeOffset}"
                                    ValueSelector="{x:Static local:SampleColumnSelectors.CreatedAt}" />
    </local:SampleColumnDefinitions>
  </Window.Resources>

  <TabControl Margin="16">
    <TabItem Header="AXAML view and columns">
      <Grid Margin="8" RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <TextBlock Text="Kubernetes workload rows" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="Sort by a header. Use its filter button to filter rows." />
        <table:DynamicTableView x:Name="XamlTable" Grid.Row="2" />
      </Grid>
    </TabItem>
    <TabItem Header="C# view and columns">
      <Grid Margin="8" RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <TextBlock Text="Kubernetes workload rows" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="Sort by a header. Use its filter button to filter rows." />
        <ContentControl x:Name="CodeFirstHost" Grid.Row="2" />
      </Grid>
    </TabItem>
  </TabControl>
</Window>
