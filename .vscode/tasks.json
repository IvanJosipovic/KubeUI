{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "dotnet: format solution",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "format",
                "KubeUI.slnx",
                "--verbosity",
                "Minimal"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "dotnet: restore",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "restore"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "dotnet: build Desktop",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "src/KubeUI.Desktop/KubeUI.Desktop.csproj",
                "--no-restore",
                "--tl:off",
                "-clp:ErrorsOnly"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "dotnet: test",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "test",
                "--no-restore",
                "--tl:off",
                "-clp:ErrorsOnly",
                "--hangdump",
                "--hangdump-timeout 1m"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
