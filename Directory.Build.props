<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>

    <EnableAvaloniaXamlCompilation>false</EnableAvaloniaXamlCompilation>

    <WarningsAsErrors>$(WarningsAsErrors);CA1001</WarningsAsErrors>

    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>

    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --config-file $(MSBuildThisFileDirectory)testconfig.json</TestingPlatformCommandLineArguments>
  </PropertyGroup>
</Project>
