<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <Features>runtime-async=on</Features>

    <EnableAvaloniaXamlCompilation>false</EnableAvaloniaXamlCompilation>

    <WarningsAsErrors>$(WarningsAsErrors);CA1001;NU1510</WarningsAsErrors>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- AOT/trim diagnostics are tracked in the separate KubeUI-eng change "AOT/trim warning readiness".
         This includes third-party ILLink diagnostics surfaced during trimmed publish.
         Remove these exceptions when that change lands. -->
    <!-- CSharpUI generates an internal GeneratedControlFactories class per compilation, so friend
         assemblies see each other's copy (CS0436); the local copy always wins. SVCUIGEN009 reports
         generated factory-name collisions (for example the 35 PropertiesView controls); this repo
         constructs controls explicitly and does not call those factories. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2026;IL2046;IL2055;IL2057;IL2060;IL2067;IL2070;IL2072;IL2075;IL2090;IL2091;IL3050;YDNG001;DI0005;CS0436;SVCUIGEN009</WarningsNotAsErrors>

    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>

    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --config-file $(MSBuildThisFileDirectory)testconfig.json</TestingPlatformCommandLineArguments>
  </PropertyGroup>
</Project>
