{
  "platformOptions": {
    "resultDirectory": "./TestResults"
  },
  "commandLineOptions": {
    "coverage": true,
    "crashdump": true,
    "hangdump": true,
    "hangdump-timeout": "5m",
    "report-xunit-trx": true
  },
  "codeCoverage": {
    "Configuration": {
      "Format": "cobertura",
      "CodeCoverage": {
        "EnableDynamicManagedInstrumentation": true,
        "EnableStaticManagedInstrumentation": false
      }
    }
  },
  "xUnit": {
    "longRunningTestSeconds": 30,
    "diagnosticMessages": true,
    "showLiveOutput": true
  }
}
