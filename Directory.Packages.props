<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia Core -->
    <PackageVersion Include="Avalonia" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Markup.Declarative" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.5" />
    
    <!-- Dock -->
    <PackageVersion Include="Dock.Model.Mvvm" Version="12.1.0.2" />
    <PackageVersion Include="Dock.Avalonia" Version="12.1.0.2" />
    <PackageVersion Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.2" />
    
    <!-- MVVM -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    
    <!-- Icons -->
    <PackageVersion Include="FluentIcons.Avalonia" Version="2.1.344" />
    
    <!-- Data/Collections -->
    <PackageVersion Include="DynamicData" Version="9.5.0" />
    <PackageVersion Include="System.Reactive" Version="6.1.0" />
    
    <!-- UI Controls -->
    <PackageVersion Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageVersion Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
    <PackageVersion Include="SvcSystems.Avalonia.DynamicTableView" Version="1.0.0-alpha.19" />
    <PackageVersion Include="SvcSystems.UI.Terminal" Version="2.3.0" />
    <PackageVersion Include="Xaml.Behaviors.Avalonia" Version="12.0.7" />
    <PackageVersion Include="HanumanInstitute.MvvmDialogs.Avalonia" Version="2.4.0" />
    <PackageVersion Include="HanumanInstitute.MvvmDialogs.Avalonia.Fluent" Version="2.4.0" />
    <PackageVersion Include="Irihi.Ursa" Version="2.2.0" />
    <PackageVersion Include="Irihi.Ursa.Themes.Semi" Version="2.2.0" />
    <PackageVersion Include="Irihi.Lingua" Version="1.1.0" />
    <PackageVersion Include="LiveMarkdown.Avalonia" Version="2.5.1" />
    <PackageVersion Include="Semi.Avalonia" Version="12.1.0.1" />
    <PackageVersion Include="PropertyGenerator.Avalonia" Version="1.3.1" />
    
    <!-- Graph -->
    <PackageVersion Include="Westermo.GraphX.Controls.Avalonia" Version="4.4.8" />
    <PackageVersion Include="Westermo.GraphX.Controls.Avalonia.Themes.Fluent" Version="4.2.0" />
    <PackageVersion Include="Westermo.GraphX.Logic" Version="4.4.8" />
    
    <!-- Helm -->
    <PackageVersion Include="Helm.NET" Version="1.0.0-alpha.11" />
    
    <!-- Kubernetes -->
    <PackageVersion Include="KubernetesClient" Version="21.0.8" />
    <PackageVersion Include="KubernetesClient.Informer" Version="1.4.1" />
    <PackageVersion Include="KokoroSharp.CPU" Version="0.8.4" />
    
    <!-- YAML/Serialization -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="SVCSystems.Text.Json.Yaml" Version="1.0.0-alpha.3" />
    <PackageVersion Include="JsonPathLINQ" Version="1.0.0-alpha.16" />
    <PackageVersion Include="Microsoft.OpenApi" Version="3.11.0" />
    
    <!-- Azure -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.ResourceManager" Version="1.14.0" />
    <PackageVersion Include="Azure.ResourceManager.ContainerService" Version="1.9.0" />
    
    <!-- Microsoft Extensions -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    
    <!-- OpenTelemetry -->
    <PackageVersion Include="OpenTelemetry" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
