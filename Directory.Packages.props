    <PackageVersion Include="TextMateSharp.Grammars" Version="2.0.4" />
    
    <!-- Utilities -->
    <PackageVersion Include="Humanizer.Core" Version="3.0.10" />
    <PackageVersion Include="Swordfish.NET.CollectionsV3" Version="3.3.16" />
    <PackageVersion Include="NuGet.Versioning" Version="7.9.0" />
    <PackageVersion Include="Velopack" Version="1.2.161" />
    <PackageVersion Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.1.0-dev-798" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.67.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.67.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.28.3" />
    <PackageVersion Include="NReco.Logging.File" Version="1.4.0" />
    <PackageVersion Include="CliWrap" Version="3.10.5" />
    <PackageVersion Include="Declarative.Avalonia.AgentTools" Version="12.2.0" />
    
    <!-- Testing -->
    <PackageVersion Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="3.2.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CrashDump" Version="2.5.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.2" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="roslynator.analyzers" Version="5.0.1" />
    <PackageVersion Include="ServiceScan.SourceGenerator" Version="3.2.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
