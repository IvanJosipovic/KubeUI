<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Avalonia.Markup.Declarative" />
    <Using Include="FluentIcons.Common" />
    <Using Include="KubeUI.Features.GatewayApi.Assets" />
    <Using Include="KubeUI.Foundation.Localization" />
    <Using Include="KubeUI.Features.Resources" />
    <Using Include="KubeUI.Features.Resources.Assets" />
    <Using Include="KubeUI.Kubernetes" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="ServiceScan.SourceGenerator" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KubeUI.App.Tests" />
    <InternalsVisibleTo Include="KubeUI.Features.GatewayApi.Tests" />
    <ProjectCapability Include="Avalonia" />
    <ProjectReference Include="..\KubeUI.Controls\KubeUI.Controls.csproj" />
    <ProjectReference Include="..\KubeUI.Features.Resources\KubeUI.Features.Resources.csproj" />
    <ProjectReference Include="..\KubeUI.Kubernetes\KubeUI.Kubernetes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Assets\Resources*.json" />
    <Watch Include="Assets\Resources*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Irihi.Lingua" />
    <PackageReference Include="Avalonia.Markup.Declarative" />
    <PackageReference Include="FluentIcons.Avalonia" />
    <PackageReference Include="ServiceScan.SourceGenerator" PrivateAssets="all" />
  </ItemGroup>
</Project>
