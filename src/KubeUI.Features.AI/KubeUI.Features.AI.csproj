<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2055;IL2057;IL2060;IL2062;IL2067;IL2070;IL2072;IL2075;IL2087;IL2090;IL2091</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Avalonia" />
    <Using Include="Avalonia.Controls" />
    <Using Include="Avalonia.Data" />
    <Using Include="Avalonia.Interactivity" />
    <Using Include="Avalonia.Layout" />
    <Using Include="Avalonia.Markup.Declarative" />
    <Using Include="Avalonia.Media" />
    <Using Include="Avalonia.Threading" />
    <Using Include="CommunityToolkit.Mvvm.ComponentModel" />
    <Using Include="CommunityToolkit.Mvvm.Input" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="System.Collections.ObjectModel" />
    <Using Include="System.ComponentModel" />
    <InternalsVisibleTo Include="KubeUI.Avalonia.Tests" />
    <InternalsVisibleTo Include="KubeUI.Features.AI.Tests" />
    <InternalsVisibleTo Include="KubeUI.Desktop" />
    <Using Include="KubeUI.Features.AI.Assets.LanguageManager" Alias="L10n" />
    <Using Include="KubeUI.Foundation.Localization" />
    <Using Include="KubeUI.Controls.Presentation" />
    <Using Include="KubeUI.Controls.DependencyInjection" />
    <ProjectReference Include="..\KubeUI.Controls\KubeUI.Controls.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Assets\Resources*.json" />
    <Watch Include="Assets\Resources*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SvcSystems.AI.AgentClientProtocol" />
    <PackageReference Include="Irihi.Lingua" />
    <PackageReference Include="Avalonia.Markup.Declarative" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="HanumanInstitute.MvvmDialogs.Avalonia.Fluent" />
    <PackageReference Include="LiveMarkdown.Avalonia" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="ServiceScan.SourceGenerator" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
