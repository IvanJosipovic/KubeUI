<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaIncludeApplicationIconAsWindowIcon>false</AvaloniaIncludeApplicationIconAsWindowIcon>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishSelfContained>true</PublishSelfContained>
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">true</PublishTrimmed>
    <TrimMode Condition="'$(Configuration)' == 'Release'">full</TrimMode>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PackageIcon>..\KubeUI.Avalonia\Assets\icon.ico</PackageIcon>
    <ApplicationIcon>..\KubeUI.Avalonia\Assets\icon.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="NReco.Logging.File" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Process" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Resources.OperatingSystem" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <TrimmerRootAssembly Include="KubernetesClient" /> <!-- Reflection-based YAML serialization inspects Kubernetes API models. -->
    <!-- Whole-assembly roots increase bundle size; each item retains the named reflection-based runtime feature. -->
    <TrimmerRootAssembly Include="Xaml.Behaviors.Interactivity" /> <!-- Helm lifecycle EventTriggerBehavior resolves event members dynamically. -->
    <TrimmerRootAssembly Include="JsonPathLINQ" /> <!-- Kubernetes JSONPath resource queries. -->
    <TrimmerRootAssembly Include="HanumanInstitute.MvvmDialogs.Avalonia" /> <!-- Runtime Avalonia dialog/view resolution. -->
    <TrimmerRootAssembly Include="Dock.Avalonia" /> <!-- Docking default templates and runtime view creation. -->
    <TrimmerRootDescriptor Include="ILLink.XamlRoots.xml" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Declarative.Avalonia.AgentTools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KubeUI.App\KubeUI.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KubeUI.Avalonia.Tests" />
    <InternalsVisibleTo Include="KubeUI.Benchmarks" />
  </ItemGroup>

  <Target Name="DisableAnalyzers" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Avalonia.Markup.Declarative.SourceGenerator' Or '%(Filename)' == 'Avalonia.Generators' Or '%(Filename)' == 'Avalonia.Analyzers.VisualBasic' or '%(Filename)' == 'Avalonia.Analyzers.CSharp' or '%(Filename)' == 'CommunityToolkit.Mvvm.SourceGenerators'" />
    </ItemGroup>
  </Target>
</Project>
