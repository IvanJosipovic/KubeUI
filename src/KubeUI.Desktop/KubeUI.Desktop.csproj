<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaIncludeApplicationIconAsWindowIcon>false</AvaloniaIncludeApplicationIconAsWindowIcon>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishSelfContained>true</PublishSelfContained>
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">true</PublishTrimmed>
    <TrimMode Condition="'$(Configuration)' == 'Release'">full</TrimMode>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PackageIcon>..\KubeUI.Avalonia\Assets\icon.ico</PackageIcon>
    <ApplicationIcon>..\KubeUI.Avalonia\Assets\icon.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="NReco.Logging.File" Version="1.4.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Process" Version="1.19.0-rc.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Resources.OperatingSystem" Version="1.19.1-beta.1" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <TrimmerRootAssembly Include="KubernetesClient" /> <!-- Reflection-based YAML serialization inspects Kubernetes API models. -->
    <!-- Whole-assembly roots increase bundle size; each item retains the named reflection-based runtime feature. -->
    <TrimmerRootAssembly Include="Avalonia.Controls.DataGrid" /> <!-- Resource and cluster DataGrid reflection over row properties. -->
    <TrimmerRootAssembly Include="AvaloniaEdit" /> <!-- AvaloniaEdit Fluent theme is loaded through a runtime StyleInclude. -->
    <TrimmerRootAssembly Include="Xaml.Behaviors.Interactivity" /> <!-- Pod log editor EventTriggerBehavior and CallMethodAction. -->
    <TrimmerRootAssembly Include="dotacp.client" /> <!-- ACP client protocol dispatch. -->
    <TrimmerRootAssembly Include="dotacp.protocol" /> <!-- ACP message and data contracts. -->
    <TrimmerRootAssembly Include="Newtonsoft.Json" /> <!-- ACP accepts host-provided CLR payload objects through its compatibility serializer. -->
    <TrimmerRootAssembly Include="JsonPathLINQ" /> <!-- Kubernetes JSONPath resource queries. -->
    <TrimmerRootAssembly Include="HanumanInstitute.MvvmDialogs.Avalonia" /> <!-- Runtime Avalonia dialog/view resolution. -->
    <TrimmerRootAssembly Include="Dock.Avalonia" /> <!-- Docking default templates and runtime view creation. -->
    <TrimmerRootAssembly Include="LiveMarkdown.Avalonia" /> <!-- Markdown resource and style includes. -->
    <TrimmerRootAssembly Include="Semi.Avalonia" /> <!-- Semi theme resources loaded by KubeUI themes. -->
    <TrimmerRootAssembly Include="Ursa.Themes.Semi" /> <!-- Ursa/Semi theme resources. -->
    <TrimmerRootAssembly Include="Dock.Avalonia.Themes.Fluent" /> <!-- Dock Fluent theme resources. -->
    <TrimmerRootAssembly Include="Westermo.GraphX.Controls.Avalonia.Themes.Fluent" /> <!-- GraphX Fluent theme resources. -->
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Declarative.Avalonia.AgentTools" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KubeUI.Avalonia\KubeUI.Avalonia.csproj" />
    <ProjectReference Include="..\KubeUI.Kubernetes\KubeUI.Kubernetes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KubeUI.Avalonia.Tests" />
    <InternalsVisibleTo Include="KubeUI.Benchmarks" />
  </ItemGroup>

  <Target Name="DisableAnalyzers" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Avalonia.Markup.Declarative.SourceGenerator' Or '%(Filename)' == 'Avalonia.Generators' Or '%(Filename)' == 'Avalonia.Analyzers.VisualBasic' or '%(Filename)' == 'Avalonia.Analyzers.CSharp' or '%(Filename)' == 'CommunityToolkit.Mvvm.SourceGenerators'" />
    </ItemGroup>
  </Target>
</Project>
