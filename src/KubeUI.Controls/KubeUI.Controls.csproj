<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <WarningsAsErrors>$(WarningsAsErrors);IL2091</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Avalonia" />
    <Using Include="Avalonia.Collections" />
    <Using Include="Avalonia.Controls" />
    <Using Include="Avalonia.Data" />
    <Using Include="Avalonia.Media" />
    <Using Include="Avalonia.Layout" />
    <Using Include="Avalonia.Markup.Declarative" />
    <Using Include="Avalonia.Styling" />
    <Using Include="Dock.Model.Mvvm.Controls" />
    <Using Include="CommunityToolkit.Mvvm.ComponentModel" />
    <Using Include="FluentIcons.Common" />
    <Using Include="PropertyGenerator.Avalonia" />
    <Using Include="System.Collections" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KubeUI.App" />
    <InternalsVisibleTo Include="KubeUI.Avalonia.Tests" />
    <InternalsVisibleTo Include="KubeUI.Features.Resources.Tests" />
    <InternalsVisibleTo Include="KubeUI.Benchmarks" />
    <ProjectReference Include="..\KubeUI.Avalonia\KubeUI.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Markup.Declarative" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Dock.Model.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="FluentIcons.Avalonia" />
    <PackageReference Include="PropertyGenerator.Avalonia">
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Svg.Controls.Skia.Avalonia" />
  </ItemGroup>
</Project>
