<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2055;IL2057;IL2060;IL2062;IL2067;IL2070;IL2072;IL2075;IL2087;IL2090;IL2091</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="CommunityToolkit.Mvvm.ComponentModel" />
    <Using Include="KubeUI.Kubernetes" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="System.Collections" />
    <Using Include="System.Collections.ObjectModel" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KubeUI.Kubernetes.Tests" />
    <InternalsVisibleTo Include="KubeUI.Avalonia.Tests" />
    <InternalsVisibleTo Include="KubeUI.Features.Resources.Tests" />
    <InternalsVisibleTo Include="KubeUI.Features.Helm.Tests" />
    <InternalsVisibleTo Include="KubeUI.Testing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" PrivateAssets="all" />
    <PackageReference Include="DynamicData" />
    <PackageReference Include="Humanizer.Core" />
    <PackageReference Include="KubernetesClient" />
    <PackageReference Include="KubernetesClient.Informer" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Swordfish.NET.CollectionsV3" />
    <PackageReference Include="YamlDotNet.System.Text.Json" />
    <PackageReference Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" PrivateAssets="all" />
  </ItemGroup>
</Project>
