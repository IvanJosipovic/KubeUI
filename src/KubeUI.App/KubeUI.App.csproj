    <ProjectReference Include="..\KubeUI.Features.Crossplane\KubeUI.Features.Crossplane.csproj" />
    <ProjectReference Include="..\KubeUI.Features.GatewayApi\KubeUI.Features.GatewayApi.csproj" />
    <ProjectReference Include="..\KubeUI.Features.Helm\KubeUI.Features.Helm.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <EmbeddedResource Include="ILLink.Substitutions.xml">
      <LogicalName>ILLink.Substitutions.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Avalonia.Markup.Declarative" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
