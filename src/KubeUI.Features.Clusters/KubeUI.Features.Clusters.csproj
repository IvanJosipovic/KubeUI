<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Avalonia" />
    <Using Include="Avalonia.Controls" />
    <Using Include="Avalonia.Data" />
    <Using Include="Avalonia.Interactivity" />
    <Using Include="Avalonia.Layout" />
    <Using Include="Avalonia.Markup.Declarative" />
    <Using Include="Avalonia.Media" />
    <Using Include="Avalonia.Threading" />
    <Using Include="CommunityToolkit.Mvvm.ComponentModel" />
    <Using Include="CommunityToolkit.Mvvm.Input" />
    <Using Include="KubeUI.Controls.Presentation" />
    <Using Include="KubeUI.Controls.DependencyInjection" />
    <Using Include="KubeUI.Controls.Platform" />
    <Using Include="KubeUI.Avalonia.Styles" />
    <Using Include="KubeUI.Features.Clusters.Assets" Alias="Assets" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="SvcSystems.Avalonia.DynamicTableView" />
    <Using Include="System.Collections.ObjectModel" />
    <Using Include="System.ComponentModel" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KubeUI.Avalonia.Tests" />
    <ProjectCapability Include="Avalonia" />
    <ProjectReference Include="..\KubeUI.Controls\KubeUI.Controls.csproj" />
    <ProjectReference Include="..\KubeUI.Kubernetes\KubeUI.Kubernetes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(BaseIntermediateOutputPath)\Resources.Designer.cs" Condition="'$(DesignTimeBuild)' == 'true'" AutoGen="true" DesignTime="true" Visible="false" />
    <EmbeddedResource Update="Assets\Resources.resx">
      <PublicClass>true</PublicClass>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>KubeUI.Features.Clusters.Assets</StronglyTypedNamespace>
      <StronglyTypedClassName>Resources</StronglyTypedClassName>
      <StronglyTypedFileName>$(BaseIntermediateOutputPath)\Resources.Designer.cs</StronglyTypedFileName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Markup.Declarative" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="DynamicData" />
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="FluentIcons.Avalonia" />
    <PackageReference Include="HanumanInstitute.MvvmDialogs.Avalonia.Fluent" />
    <PackageReference Include="ServiceScan.SourceGenerator" PrivateAssets="all" />
    <PackageReference Include="SvcSystems.Avalonia.DynamicTableView" />
    <PackageReference Include="Xaml.Behaviors.Avalonia" />
  </ItemGroup>
</Project>
